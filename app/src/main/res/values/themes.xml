<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 去掉系统 ActionBar，自己画头部，界面更干净 -->
    <style name="Theme.AotuFire" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@color/hero_start</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <!-- 亮屏解锁用的透明主题：显示在锁屏之上，不干扰用户 -->
    <style name="Theme.AotuFire.Wake" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- ============ 文字层级 ============ -->
    <style name="THero">
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_on_primary</item>
    </style>

    <style name="THeroSub">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#EBFFFFFF</item>
    </style>

    <style name="TSection">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TCaption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="TMono">
        <item name="android:textSize">11sp</item>
        <item name="android:typeface">monospace</item>
        <item name="android:textColor">@color/code_text</item>
    </style>

    <!-- ============ 卡片 ============ -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <!-- ============ 按钮 ============ -->
    <style name="BtnPrimary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BtnSecondary">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">46dp</item>
    </style>

    <style name="BtnGhost">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="BtnTiny">
        <item name="android:background">@drawable/btn_tiny</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">58dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- ============ 输入框 ============ -->
    <style name="Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>
</resources>
